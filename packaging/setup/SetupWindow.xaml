<Window x:Class="EddiesSetup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Eddie's Map Editor Setup"
        Width="620" Height="400"
        WindowStyle="None" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Icon="icon.png">
  <!-- its own title bar in the window's colors; the bar still drags the window -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="32" GlassFrameThickness="0" ResizeBorderThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- a button: flat, rounded, a shade lighter under the mouse, outlined in the accent with the keyboard on it -->
    <Style x:Key="Plain" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Background" Value="{DynamicResource Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="MinWidth" Value="118" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Margin" Value="12,0,0,0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0,16,1" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Opacity" Value="0.85" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Opacity" Value="0.7" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Focus}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Face" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- the window's one main action -->
    <Style x:Key="Main" TargetType="Button" BasedOn="{StaticResource Plain}">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- a button that reads as a link, eg Uninstall beside the main actions -->
    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Soft}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="Words" Text="{TemplateBinding Content}" Background="Transparent" Padding="0,8" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Words" Property="TextDecorations" Value="Underline" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Words" Property="TextDecorations" Value="Underline" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Margin" Value="0,0,32,0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1"
                      BorderBrush="{DynamicResource Line}" Background="{DynamicResource Panel}">
                <Path x:Name="Tick" Data="M 4,9 L 7.5,12.5 L 13,5.5" Stroke="White" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Visibility="Collapsed" />
              </Border>
              <ContentPresenter Margin="8,0,0,1" VerticalAlignment="Center" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Focus}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="4" Background="{DynamicResource Panel}" />
              <Border x:Name="PART_Indicator" CornerRadius="4" Background="{DynamicResource Accent}"
                      HorizontalAlignment="Left" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border BorderBrush="{DynamicResource Line}" BorderThickness="1">
    <Grid x:Name="Root">
      <Grid.RowDefinitions>
        <RowDefinition Height="32" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- the title bar -->
      <Grid Grid.Row="0" Background="{DynamicResource Panel}">
        <TextBlock Text="Eddie's Map Editor Setup" Foreground="{DynamicResource Soft}" FontSize="12"
                   VerticalAlignment="Center" Margin="14,0,0,1" />
        <Button x:Name="CloseButton" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                Width="46" HorizontalAlignment="Right" ToolTip="Close"
                Foreground="{DynamicResource Soft}" Background="Transparent" BorderThickness="0"
                Focusable="False" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                Click="OnClose">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Face" Background="Transparent">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Face" Property="Background" Value="#E81123" />
                  <Setter Property="Foreground" Value="White" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </Grid>

      <Grid Grid.Row="1" Margin="40,30,40,28">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- what is installed: the icon on a light card, as it is drawn for a light ground -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
          <Border Width="96" Height="96" CornerRadius="12" Background="#F3F4F6">
            <Image Source="icon.png" Width="84" Height="84" RenderOptions.BitmapScalingMode="HighQuality" />
          </Border>
          <StackPanel Margin="28,6,0,0">
            <TextBlock Text="Eddie's Map Editor" FontSize="26" FontWeight="SemiBold" />
            <TextBlock x:Name="VersionLine" Foreground="{DynamicResource Soft}" Margin="0,8,0,0" />
            <TextBlock x:Name="NoteLine" Foreground="{DynamicResource Soft}" Margin="0,6,0,0" />
          </StackPanel>
        </StackPanel>

        <!-- one of these shows -->
        <Grid Grid.Row="1" Margin="0,30,0,0">
          <StackPanel x:Name="InstallPage" Visibility="Collapsed">
            <TextBlock Text="Install to" Foreground="{DynamicResource Soft}" FontSize="12" />
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Height="34" CornerRadius="6" BorderThickness="1"
                      BorderBrush="{DynamicResource Line}" Background="{DynamicResource Panel}">
                <TextBlock x:Name="FolderText" VerticalAlignment="Center" Margin="12,0,12,1"
                           TextTrimming="CharacterEllipsis" />
              </Border>
              <Button x:Name="ChangeButton" Grid.Column="1" Content="Change…" Style="{StaticResource Plain}"
                      MinWidth="92" Click="OnChangeFolder" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
              <CheckBox x:Name="StartMenuBox" Content="Start menu entry" />
              <CheckBox x:Name="DesktopBox" Content="Desktop shortcut" />
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="ProgressPage" Visibility="Collapsed" Margin="0,10,0,0">
            <TextBlock x:Name="ProgressTitle" />
            <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Margin="0,14,0,0" />
            <TextBlock x:Name="ProgressNote" Foreground="{DynamicResource Soft}" FontSize="12" Margin="0,10,0,0" />
          </StackPanel>

          <!-- every page that only says something -->
          <StackPanel x:Name="MessagePage" Visibility="Collapsed" Margin="0,4,0,0">
            <TextBlock x:Name="MessageTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText" Foreground="{DynamicResource Soft}" TextWrapping="Wrap"
                       Margin="0,10,0,0" LineHeight="20" />
          </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
          <Button x:Name="LinkButton" Style="{StaticResource Link}" HorizontalAlignment="Left"
                  VerticalAlignment="Center" Visibility="Collapsed" Click="OnLink" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SecondButton" Style="{StaticResource Plain}" Click="OnSecond" />
            <Button x:Name="MainButton" Style="{StaticResource Main}" IsDefault="True" Click="OnMain" />
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
